{
  "apps": [
    {
      "name": "quiz-backend",
      "script": "./start_backend.sh",
      "cwd": "./",
      "interpreter": "bash",
      "autorestart": true,
      "restart_delay": 5000,
      "max_restarts": 15,
      "watch": false,
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "out_file": "./logs/backend_out.log",
      "error_file": "./logs/backend_err.log",
      "time": true
    },
    {
      "name": "quiz-kiosk",
      "script": "./start_kiosk.sh",
      "cwd": "./",
      "interpreter": "bash",
      "autorestart": true,
      "restart_delay": 8000,
      "max_restarts": 10,
      "watch": false,
      "out_file": "./logs/kiosk_out.log",
      "error_file": "./logs/kiosk_err.log",
      "time": true
    }
  ]
}
